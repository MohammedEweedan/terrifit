DATABASE_URL="postgresql://user:password@localhost:5432/terrifit"

# Set only after the native apps have public store listings.
APP_STORE_URL=""
PLAY_STORE_URL=""
NEXT_PUBLIC_SITE_URL="https://terrifit.com"

# --- Cloudflare R2 (media) -------------------------------------------------
# Where the pages request /media from. Unset means "serve from public/", which
# is the fallback the site falls back to anyway if R2 stops answering.
NEXT_PUBLIC_MEDIA_BASE=""
# Credentials for scripts/sync-r2.mjs. Never needed at runtime — only to upload.
R2_ACCOUNT_ID="https://445b19bc8b7ff11c4d58efe52c1ec96b.r2.cloudflarestorage.com/terrifit-media"  # from the R2 S3 endpoint hostname
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Cloudflare Turnstile (bot protection on the public forms) -------------
# Enforcement keys off the SECRET alone. Unset, the widget renders nothing and
# the server skips the check, so the forms behave exactly as they do today.
#
# The site key is public — it is served in the page HTML — so it lives here.
# The secret is not: set it in Vercel's environment variables, never in the repo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAErS0U_FTe3dZG7O"
TURNSTILE_SECRET_KEY=""
# Hostnames a solved challenge may come from. Defaults to the apex, www,
# localhost and the current Vercel deployment; set to override.
TURNSTILE_ALLOWED_HOSTNAMES=""

# --- Stripe ----------------------------------------------------------------
# The publishable key is public and may live in config. The secret key and the
# webhook signing secret must only ever be set in the hosting platform.
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""

# Direct USDT on Tron. Set to a valid TRC-20 wallet to offer the rail; leave
# empty and it does not appear at checkout.
USDT_TRC20_ADDRESS=""

# "true" opens paid pre-orders for hardware (Band, Scale, v1 accessories).
HARDWARE_PREORDERS_OPEN=""
