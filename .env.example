DATABASE_URL="postgresql://user:password@localhost:5432/terrifit"

# Set only after the native apps have public store listings.
APP_STORE_URL=""
PLAY_STORE_URL=""
NEXT_PUBLIC_SITE_URL="https://terrifit.com"

# --- Cloudflare R2 (media) -------------------------------------------------
# Where the pages request /media from. Unset means "serve from public/", which
# is the fallback the site falls back to anyway if R2 stops answering.
NEXT_PUBLIC_MEDIA_BASE=""
# Credentials for scripts/sync-r2.mjs. Never needed at runtime — only to upload.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Cloudflare Turnstile (bot protection on the public forms) -------------
# Both unset means the challenge is skipped on the client and not enforced on
# the server, so the forms behave exactly as they do today.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
