{
  "name": "ryvn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:i18n": "node --experimental-strip-types scripts/validate-dictionaries.mjs",
    "media:manifest": "node --experimental-strip-types scripts/media-manifest.mjs",
    "app": "npm start --prefix mobile",
    "app:ios": "npm run ios --prefix mobile",
    "app:android": "npm run android --prefix mobile",
    "app:check": "npm run typecheck --prefix mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:grant": "node --experimental-strip-types scripts/grant-admin.mjs",
