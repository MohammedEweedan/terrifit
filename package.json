    "sync:prices": "node --experimental-strip-types scripts/sync-catalog-prices.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "framer-motion": "^12.43.0",
